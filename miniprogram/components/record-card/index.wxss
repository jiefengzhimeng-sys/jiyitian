.rc {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border: 1rpx solid #f0ebe0;
  border-radius: 36rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(60, 48, 30, 0.04);
  position: relative;
  overflow: hidden;
}

/* 时间线样式：左侧色条 */
.rc.timeline {
  align-items: flex-start;
  border-radius: 32rpx;
  padding: 22rpx 24rpx 22rpx 26rpx;
}
.rc-bar {
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
}

.rc-hover {
  opacity: 0.86;
  transform: scale(0.99);
}

.rc-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex: none;
}

.rc-main {
  flex: 1;
  min-width: 0;
}

.rc-title {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: -0.2rpx;
  color: #17161a;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.rc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.rc-mood {
  font-size: 18rpx;
  color: #8e8b96;
}

.wave {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  height: 24rpx;
}
.wave-i {
  width: 4rpx;
  background: #b9a7ff;
  border-radius: 4rpx;
}
.rc-dur {
  font-size: 18rpx;
  color: #8e8b96;
  margin-left: 6rpx;
}

.rc-thumbs {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}
.thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2ebdf;
}
.thumb-img {
  width: 100%;
  height: 100%;
}

.rc-time {
  font-size: 18rpx;
  color: #8e8b96;
  flex: none;
  align-self: flex-start;
  padding-top: 6rpx;
}
