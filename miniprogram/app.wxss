/* ============================================================
   记一天 · 全局样式与设计令牌
   设计语言：纸上手账 —— 奶油纸底 / 墨黑字 / 荧光青柠签名色
   ============================================================ */

page {
  /* 底色 */
  --paper: #FAF6EF;
  --paper-2: #F2EBDF;
  --paper-3: #E9E0D1;
  --card: #FFFFFF;

  /* 墨色三级 */
  --ink: #17161A;
  --ink-2: #57555F;
  --ink-3: #8E8B96;
  --line: #E8E1D4;
  --line-2: #F0EBE0;

  /* 签名色与功能色 */
  --lime: #D8F45C;
  --lime-deep: #B9D62F;
  --lime-wash: #EFF9C4;
  --coral: #FF6B4A;
  --coral-wash: #FFEDE8;
  --lilac: #B9A7FF;
  --lilac-wash: #F0EBFF;
  --sky: #7CC5FF;
  --sky-wash: #E6F4FF;
  --mint: #4FD8A4;
  --mint-wash: #E2F9F0;
  --amber-wash: #FFF6DE;

  /* 情绪六档 */
  --m-joy: #FFC857;
  --m-calm: #7CC5FF;
  --m-low: #8E8B96;
  --m-angry: #FF6B4A;
  --m-anx: #B9A7FF;
  --m-tired: #A9C0B4;

  /* 圆角：16 / 28 / 36 / 44 / 52rpx */
  --r-sm: 16rpx;
  --r-md: 28rpx;
  --r-lg: 36rpx;
  --r-xl: 44rpx;
  --r-full: 999rpx;

  /* 阴影（暖调，避免冷硬） */
  --sh-1: 0 2rpx 6rpx rgba(60, 48, 30, 0.05);
  --sh-2: 0 8rpx 24rpx -10rpx rgba(60, 48, 30, 0.16);
  --sh-3: 0 20rpx 44rpx -20rpx rgba(60, 48, 30, 0.26);

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", sans-serif;
  font-size: 26rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, image, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

/* ---------------- 通用原子类 ---------------- */
.page {
  min-height: 100vh;
  background: var(--paper);
}

/* 页面左右安全边距：36rpx（=18px） */
.gutter {
  padding-left: 36rpx;
  padding-right: 36rpx;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--line-2);
  box-shadow: var(--sh-1);
}

/* 分区小标签（全大写 + 字距） */
.lbl {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2.4rpx;
  color: var(--ink-3);
  text-transform: uppercase;
}

/* 大标题（800 字重 + 收紧字距） */
.h-big {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: 1.3;
}

.h-sec {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: -0.4rpx;
}

/* 正文 / 辅助 */
.t-body {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

.t-muted {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 等宽数字：手账日期戳的质感 */
.num {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-weight: 600;
  letter-spacing: -0.4rpx;
  font-variant-numeric: tabular-nums;
}

/* 胶囊标签 */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--r-full);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.4;
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.4rpx;
}
.btn-lime {
  background: var(--lime);
  color: var(--ink);
  box-shadow: 0 12rpx 28rpx -16rpx rgba(150, 180, 20, 0.9);
}
.btn-ink {
  background: var(--ink);
  color: #fff;
}
.btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 2rpx solid var(--ink);
}
.btn-soft {
  background: var(--paper-2);
  color: var(--ink-2);
}
.btn[disabled],
.btn.disabled {
  opacity: 0.45;
}

/* 按下反馈 */
.tap {
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.tap:active {
  transform: scale(0.97);
  opacity: 0.86;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 为自定义 tabBar 预留高度（58px + 安全区） */
.tabbar-space {
  height: calc(116rpx + constant(safe-area-inset-bottom));
  height: calc(116rpx + env(safe-area-inset-bottom));
}

/* 骨架屏动画 */
@keyframes sk {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.sk {
  border-radius: 20rpx;
  background: linear-gradient(90deg, #F2EBDF 25%, #F8F4EC 50%, #F2EBDF 75%);
  background-size: 200% 100%;
  animation: sk 1.4s ease-in-out infinite;
}

/* 一像素细线分隔 */
.hairline {
  height: 1rpx;
  background: var(--line);
}
