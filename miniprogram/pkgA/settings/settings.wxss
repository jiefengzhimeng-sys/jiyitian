.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 40rpx;
}

.group {
  margin: 26rpx 36rpx 0;
  padding: 0 26rpx;
  background: var(--card);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--line-2);
  box-shadow: var(--sh-1);
}
.group.hl {
  border-color: rgba(185, 214, 47, 0.8);
  box-shadow: 0 0 0 4rpx rgba(216, 244, 92, 0.22);
}
.group-lbl {
  display: block;
  padding: 22rpx 0 6rpx;
}
.divider {
  height: 1rpx;
  background: var(--line-2);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
}
.row.sub {
  padding-top: 0;
}
.row-l {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.row-t {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.3rpx;
}
.row-t.small {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.row-d {
  font-size: 18rpx;
  color: var(--ink-3);
  line-height: 1.5;
}
.ar {
  font-size: 32rpx;
  color: var(--ink-3);
  line-height: 1;
}
.picker-val {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 8rpx 20rpx;
  background: var(--paper-2);
  border-radius: var(--r-full);
}
.cache {
  font-size: 20rpx;
  color: var(--ink-3);
}
.diag {
  font-size: 19rpx;
  color: var(--ink-3);
  max-width: 380rpx;
  text-align: right;
  line-height: 1.5;
}

.bottom-space {
  height: 60rpx;
}
