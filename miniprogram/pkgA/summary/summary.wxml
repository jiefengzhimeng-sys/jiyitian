<view class="page">

  <nav-bar title="AI 总结" back="{{true}}" />

  <!-- 类型切换 -->
  <view class="types">
    <view
      wx:for="{{types}}"
      wx:key="key"
      class="ty tap {{type === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTypeTap"
    >
      <text class="ty-t">{{item.name}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="sk-box">
    <skeleton rows="4" variant="card" />
  </view>

  <block wx:else>

    <!-- 数据不足 -->
    <view wx:if="{{tooFew && !summary}}" class="few">
      <text class="few-e">🌾</text>
      <text class="few-t">这段只记了 {{recordCount}} 条</text>
      <text class="few-d">记录少的时候，AI 也读不出什么。多记几天，总结会更有洞察。</text>
      <view class="few-btn tap" bindtap="goRecord">去记一笔</view>
    </view>

    <!-- 未生成：云端定时任务在周期末预生成，用户也可能提前进来 -->
    <view wx:elif="{{empty}}" class="few">
      <text class="few-e">📄</text>
      <text class="few-t">这一切还没有总结</text>
      <text class="few-d">这段记了 {{recordCount}} 条。让 AI 读一遍，帮你看看这段时间的节奏。</text>
      <view class="few-btn tap {{generating ? 'disabled' : ''}}" bindtap="onGenerate">
        {{generating ? '生成中…' : '生成总结'}}
      </view>
    </view>

    <block wx:else>

      <!-- 刊物封面式刊头 -->
      <view class="cover">
        <view class="cov-top">
          <text class="cov-kicker">{{kicker}}</text>
          <text class="cov-period num">{{periodText}}</text>
        </view>

        <text class="cov-title">{{summary.title}}</text>
        <view class="cov-rule"></view>
        <text class="cov-sub num">{{summary.subtitle}}</text>
      </view>

      <!-- 三段块 -->
      <view class="body">
        <view wx:for="{{blocks}}" wx:key="key" class="bk">
          <view class="bk-hd">
            <text class="bk-lbl">{{item.label}}</text>
            <text class="bk-no num">0{{index + 1}}</text>
          </view>
          <text class="bk-tx">{{item.text}}</text>
        </view>
      </view>

      <!-- 曲线 -->
      <view wx:if="{{hasWeight}}" class="curve tap" bindtap="goStats">
        <view class="cv-hd">
          <text class="cv-t">体重曲线</text>
          <text class="cv-ar">看全部数据 ›</text>
        </view>
        <chart type="line" series="{{weightSeries}}" height="{{160}}" />
      </view>

      <!-- 标签 -->
      <view class="tags">
        <view wx:for="{{tags}}" wx:key="index" class="tag">
          <text class="tag-t">{{item}}</text>
        </view>
      </view>

      <!-- 操作 -->
      <view class="acts">
        <view class="act-main tap {{generating ? 'disabled' : ''}}" bindtap="onGenerate">
          <text>{{generating ? '生成中…' : '重新生成'}}</text>
        </view>
      </view>

      <!-- 免责声明（R10-08 硬要求） -->
      <text class="disclaimer">AI 生成内容仅供参考，不构成医疗建议。总结只使用你自己的记录，仅你可见。</text>

    </block>
  </block>

  <view class="bottom-space"></view>
</view>
