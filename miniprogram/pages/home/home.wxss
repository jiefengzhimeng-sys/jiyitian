.page {
  min-height: 100vh;
  background: #faf6ef;
  padding-bottom: 40rpx;
}

/* ---------- 招呼 ---------- */
.top {
  padding: 8rpx 36rpx 0;
}
.hi {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hi-txt {
  font-size: 22rpx;
  color: #57555f;
}
.hi-name {
  color: #17161a;
  font-weight: 800;
}
.streak {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #d8f45c;
  border-radius: 999rpx;
  padding: 8rpx 18rpx 8rpx 12rpx;
}
.flame {
  font-size: 20rpx;
}
.streak-n {
  font-size: 24rpx;
  color: #17161a;
}
.streak-u {
  font-size: 17rpx;
  color: rgba(23, 22, 26, 0.6);
}
.date {
  display: block;
  font-size: 19rpx;
  color: #8e8b96;
  margin-top: 8rpx;
}

/* ---------- 情绪天气卡 ---------- */
.mood-card {
  margin: 24rpx 36rpx 0;
  border-radius: 52rpx;
  padding: 32rpx 34rpx 28rpx;
  background: linear-gradient(135deg, #1d1c22 0%, #2a2733 58%, #37303f 100%);
  position: relative;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx -24rpx rgba(60, 48, 30, 0.5);
}
/* 右上角青柠光斑 */
.mood-card::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 244, 92, 0.85) 0%, rgba(216, 244, 92, 0.12) 60%, rgba(216, 244, 92, 0) 70%);
}
.mood-lbl {
  color: rgba(255, 255, 255, 0.5);
  font-size: 17rpx;
}
.mood-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  color: #fff;
  line-height: 1.4;
  margin-top: 14rpx;
  max-width: 400rpx;
}
.mood-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
  max-width: 400rpx;
  line-height: 1.6;
}
.mood-face {
  position: absolute;
  right: 34rpx;
  top: 62rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7cc5ff, #b9a7ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 0 0 12rpx rgba(124, 197, 255, 0.14);
}
.mood-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 54rpx;
  margin-top: 26rpx;
}
.mb {
  flex: 1;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  min-height: 8rpx;
}
.mb.now {
  background: #d8f45c;
}

/* ---------- 快捷入口 ---------- */
.quick {
  display: flex;
  gap: 16rpx;
  padding: 26rpx 36rpx 0;
}
.q {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sq {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 2rpx 6rpx rgba(60, 48, 30, 0.05);
}
.q-t {
  font-size: 19rpx;
  color: #57555f;
  font-weight: 600;
  margin-top: 10rpx;
}

/* ---------- 今日记录 ---------- */
.rec-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 36rpx 16rpx;
}
.more {
  font-size: 20rpx;
  color: #8e8b96;
}
.rec-list {
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
