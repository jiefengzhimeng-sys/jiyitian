.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 40rpx;
}

/* 头部 */
.hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 36rpx 0;
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 36rpx;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 2rpx solid var(--line);
}
.hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.hero-name {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -1.2rpx;
  color: var(--ink);
}
.hero-sub {
  font-size: 18rpx;
  color: var(--ink-3);
}
.hero-streak {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--lime);
}
.hs-n {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.2;
}
.hs-l {
  font-size: 16rpx;
  font-weight: 700;
  color: rgba(23, 22, 26, 0.6);
}

/* 统计 */
.stats {
  display: flex;
  margin: 26rpx 36rpx 0;
  padding: 24rpx 0;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line-2);
}
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}
.st + .st::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 1rpx;
  background: var(--line-2);
}
.st-n {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
}
.st-l {
  font-size: 18rpx;
  color: var(--ink-3);
}

/* 快捷 */
.quick-row {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 36rpx 0;
}
.qr {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line-2);
}
.qr-e {
  font-size: 26rpx;
}
.qr-t {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}

/* 设置组 */
.group {
  margin: 32rpx 36rpx 0;
  padding: 0 26rpx;
  background: var(--card);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--line-2);
  box-shadow: var(--sh-1);
}
.group-lbl {
  display: block;
  padding: 22rpx 0 6rpx;
}
.divider {
  height: 1rpx;
  background: var(--line-2);
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
}
.row.sub {
  padding-top: 0;
}
.row-l {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.row-t {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.3rpx;
}
.row-t.small {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--ink-2);
}
.row-d {
  font-size: 18rpx;
  color: var(--ink-3);
  line-height: 1.5;
}
.picker-val {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 8rpx 20rpx;
  background: var(--paper-2);
  border-radius: var(--r-full);
}
.ar {
  font-size: 32rpx;
  color: var(--ink-3);
  line-height: 1;
}

/* 开发辅助 */
.dev {
  margin: 32rpx 36rpx 0;
  padding: 22rpx 26rpx;
  border-radius: var(--r-lg);
  background: var(--amber-wash);
  border: 1rpx dashed rgba(255, 200, 87, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.dev-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}
.dev-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D9A22B;
}
.dev-t {
  font-size: 18rpx;
  color: #8A6516;
  line-height: 1.4;
}
.dev-btn {
  padding: 10rpx 22rpx;
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, 0.7);
  font-size: 19rpx;
  font-weight: 800;
  color: #8A6516;
}

.ver {
  margin-top: 36rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--paper-3);
}
